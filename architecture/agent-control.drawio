<mxfile host="app.diagrams.net"><diagram id="agent-control" name="Agent control"><mxGraphModel dx="2800" dy="1600" grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1400"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="background" value="" style="html=1;whiteSpace=wrap;fillColor=#F4F7FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2400" height="1400" /></mxCell><mxCell id="title" value="&lt;b&gt;The agent is a bounded controller, not an unbounded conversation&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="40" width="2250" height="80" /></mxCell><mxCell id="subtitle" value="Each executed tool action and final answer consumes one of 3–8 available steps." style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="140" width="2220" height="70" /></mxCell><mxCell id="footer" value="ReAct Workbench · Source-derived functional view · Manisha · 2026-10-15 · us-east-2" style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1320" width="2220" height="45" /></mxCell><mxCell id="budget" value="1 · Budget check&lt;br&gt;&lt;br&gt;Check runtime deadline&lt;br&gt;and remaining steps" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;spacingTop=78;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="290" width="560" height="235" /></mxCell><mxCell id="budget-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.event_time_based;strokeColor=none;fillColor=#E7157B;" vertex="1" parent="budget"><mxGeometry as="geometry" x="251" y="22" width="58" height="58" /></mxCell><mxCell id="model" value="2 · Obtain model action&lt;br&gt;&lt;br&gt;Converse or queued native request&lt;br&gt;maxTokens 1,000; temperature 0" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;spacingTop=78;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="290" width="560" height="235" /></mxCell><mxCell id="model-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;strokeColor=#ffffff;fillColor=#01A88D;" vertex="1" parent="model"><mxGeometry as="geometry" x="251" y="22" width="58" height="58" /></mxCell><mxCell id="validate" value="3 · Validate&lt;br&gt;&lt;br&gt;Allowlisted name + typed args&lt;br&gt;No arbitrary code or shell" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;spacingTop=78;" vertex="1" parent="1"><mxGeometry as="geometry" x="1700" y="290" width="560" height="235" /></mxCell><mxCell id="validate-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.permissions;strokeColor=none;fillColor=#DD344C;" vertex="1" parent="validate"><mxGeometry as="geometry" x="251" y="22" width="58" height="58" /></mxCell><mxCell id="record" value="6 · Record / repeat&lt;br&gt;&lt;br&gt;Persist sanitized STEP&lt;br&gt;Update usage and mode" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;spacingTop=78;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="730" width="560" height="235" /></mxCell><mxCell id="record-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;strokeColor=#ffffff;fillColor=#C925D1;" vertex="1" parent="record"><mxGeometry as="geometry" x="251" y="22" width="58" height="58" /></mxCell><mxCell id="observe" value="5 · Observe&lt;br&gt;&lt;br&gt;Actual tool output + source IDs&lt;br&gt;Untrusted evidence, not instructions" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;spacingTop=78;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="730" width="560" height="235" /></mxCell><mxCell id="observe-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.source_code;strokeColor=none;fillColor=#5A6C86;" vertex="1" parent="observe"><mxGeometry as="geometry" x="251" y="22" width="58" height="58" /></mxCell><mxCell id="tools" value="4 · Execute one action&lt;br&gt;&lt;br&gt;Restricted AST calculator&lt;br&gt;or curated knowledge search" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;spacingTop=78;" vertex="1" parent="1"><mxGeometry as="geometry" x="1700" y="730" width="560" height="235" /></mxCell><mxCell id="tools-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.lambda_function;strokeColor=none;fillColor=#ED7100;" vertex="1" parent="tools"><mxGeometry as="geometry" x="251" y="22" width="58" height="58" /></mxCell><mxCell id="loop0" edge="1" parent="1" source="budget" target="model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="loop1" edge="1" parent="1" source="model" target="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="loop2" edge="1" parent="1" source="validate" target="tools" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="loop3" edge="1" parent="1" source="tools" target="observe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="loop4" edge="1" parent="1" source="observe" target="record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="repeat" edge="1" parent="1" source="record" target="budget" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;dashed=1;" value="Next step"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="completion" value="&lt;b&gt;Completion protocol&lt;/b&gt;&lt;br&gt;final_answer is a structured wire response, not an executable third tool.&lt;br&gt;Validate supported evidence, retrieved IDs and inline citations before success." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#E9F4F4;strokeColor=#8ABDBA;fontColor=#164B4B;spacing=22;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="1080" width="1040" height="190" /></mxCell><mxCell id="limits" value="&lt;b&gt;Safe termination&lt;/b&gt;&lt;br&gt;Budget → LIMIT_REACHED. Invalid tool / args, model error or deadline → FAILED.&lt;br&gt;Native batches serialize one request per step; raw reasoning is never persisted." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFF1EB;strokeColor=#DF967E;fontColor=#803B2C;spacing=22;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1080" width="1040" height="190" /></mxCell><mxCell id="final-response" edge="1" parent="1" source="model" target="completion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="Final answer"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1180" y="620" /><mxPoint x="785" y="620" /><mxPoint x="785" y="1020" /><mxPoint x="620" y="1020" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>