;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1810" y="300" width="460" height="235" /></mxCell><mxCell id="worker" value="Worker Lambda&lt;br&gt;&lt;br&gt;Batch size 1 / timeout 180s&lt;br&gt;Controller deadline ≤150s" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1810" y="790" width="460" height="235" /></mxCell><mxCell id="claim" value="Conditional claim&lt;br&gt;&lt;br&gt;QUEUED → RUNNING&lt;br&gt;Duplicate claim exits" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1240" y="790" width="460" height="235" /></mxCell><mxCell id="controller" value="Shared Python controller&lt;br&gt;&lt;br&gt;Bedrock + validated tools&lt;br&gt;Persist ordered step events" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="790" width="460" height="235" /></mxCell><mxCell id="poll" value="Browser polling&lt;br&gt;&lt;br&gt;GET run, then GET steps&lt;br&gt;2 seconds until terminal" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="790" width="460" height="235" /></mxCell><mxCell id="flow0" edge="1" parent="1" source="browser" target="api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow1" edge="1" parent="1" source="api" target="table" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow2" edge="1" parent="1" source="api" target="queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" value="Enqueue after META"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="900" y="235" /><mxPoint x="2040" y="235" /></Array></mxGeometry></mxCell><mxCell id="flow3" edge="1" parent="1" source="queue" target="worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;dashed=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow4" edge="1" parent="1" source="worker" target="claim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow5" edge="1" parent="1" source="claim" target="controller" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="polling" edge="1" parent="1" source="poll" target="api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" value="JWT on reads"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="330" y="740" /><mxPoint x="610" y="740" /><mxPoint x="610" y="417" /></Array></mxGeometry></mxCell><mxCell id="response" value="&lt;b&gt;HTTP 202 immediately after enqueue&lt;/b&gt;&lt;br&gt;Return run_id + QUEUED. No waiting for Bedrock inside the HTTP request." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#E9F4F4;strokeColor=#8ABDBA;fontColor=#164B4B;spacing=22;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="1130" width="1030" height="135" /></mxCell><mxCell id="failure" value="&lt;b&gt;Enqueue failure is explicit&lt;/b&gt;&lt;br&gt;Save FAILED / MODEL_ERROR with a safe message; return HTTP 503 and run_id." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFF1EB;strokeColor=#DF967E;fontColor=#803B2C;spacing=22;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="1240" y="1130" width="1030" height="135" /></mxCell></root></mxGraphModel></diagram><diagram id="agent-control" name="Agent control"><mxGraphModel dx="2800" dy="1600" grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1400"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="background" value="" style="html=1;whiteSpace=wrap;fillColor=#F4F7FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2400" height="1400" /></mxCell><mxCell id="title" value="&lt;b&gt;The agent is a bounded controller, not an unbounded conversation&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="40" width="2250" height="80" /></mxCell><mxCell id="subtitle" value="Each executed tool action and final answer consumes one of 3–8 available steps." style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="140" width="2220" height="70" /></mxCell><mxCell id="footer" value="ReAct Workbench · Source-derived functional view · Manisha · 2026-10-15 · us-east-2" style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1320" width="2220" height="45" /></mxCell><mxCell id="budget" value="1 · Budget check&lt;br&gt;&lt;br&gt;Check runtime deadline&lt;br&gt;and remaining steps" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="290" width="560" height="235" /></mxCell><mxCell id="model" value="2 · Obtain model action&lt;br&gt;&lt;br&gt;Converse or queued native request&lt;br&gt;maxTokens 1,000; temperature 0" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="290" width="560" height="235" /></mxCell><mxCell id="validate" value="3 · Validate&lt;br&gt;&lt;br&gt;Allowlisted name + typed args&lt;br&gt;No arbitrary code or shell" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1700" y="290" width="560" height="235" /></mxCell><mxCell id="record" value="6 · Record / repeat&lt;br&gt;&lt;br&gt;Persist sanitized STEP&lt;br&gt;Update usage and mode" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="730" width="560" height="235" /></mxCell><mxCell id="observe" value="5 · Observe&lt;br&gt;&lt;br&gt;Actual tool output + source IDs&lt;br&gt;Untrusted evidence, not instructions" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="730" width="560" height="235" /></mxCell><mxCell id="tools" value="4 · Execute one action&lt;br&gt;&lt;br&gt;Restricted AST calculator&lt;br&gt;or curated knowledge search" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1700" y="730" width="560" height="235" /></mxCell><mxCell id="loop0" edge="1" parent="1" source="budget" target="model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="loop1" edge="1" parent="1" source="model" target="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="loop2" edge="1" parent="1" source="validate" target="tools" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="loop3" edge="1" parent="1" source="tools" target="observe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="loop4" edge="1" parent="1" source="observe" target="record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="repeat" edge="1" parent="1" source="record" target="budget" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;dashed=1;" value="Next step"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="completion" value="&lt;b&gt;Completion protocol&lt;/b&gt;&lt;br&gt;final_answer is a structured wire response, not an executable third tool.&lt;br&gt;Validate supported evidence, retrieved IDs and inline citations before success." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#E9F4F4;strokeColor=#8ABDBA;fontColor=#164B4B;spacing=22;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="1080" width="1040" height="190" /></mxCell><mxCell id="limits" value="&lt;b&gt;Safe termination&lt;/b&gt;&lt;br&gt;Budget → LIMIT_REACHED. Invalid tool / args, model error or deadline → FAILED.&lt;br&gt;Native batches serialize one request per step; raw reasoning is never persisted." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFF1EB;strokeColor=#DF967E;fontColor=#803B2C;spacing=22;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1080" width="1040" height="190" /></mxCell><mxCell id="final-response" edge="1" parent="1" source="model" target="completion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="Final answer"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1180" y="620" /><mxPoint x="785" y="620" /><mxPoint x="785" y="1020" /><mxPoint x="620" y="1020" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="persistence" name="Persistence"><mxGraphModel dx="2800" dy="1600" grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1400"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="background" value="" style="html=1;whiteSpace=wrap;fillColor=#F4F7FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2400" height="1400" /></mxCell><mxCell id="title" value="&lt;b&gt;One table. Owned metadata. Ordered evidence.&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="40" width="2250" height="80" /></mxCell><mxCell id="subtitle" value="DynamoDB: partition key PK = RUN#id; sort key SK = META or STEP#000n. No scan or recent-run listing." style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="140" width="2220" height="70" /></mxCell><mxCell id="footer" value="ReAct Workbench · Source-derived functional view · Manisha · 2026-10-15 · us-east-2" style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1320" width="2220" height="45" /></mxCell><mxCell id="api" value="API Lambda&lt;br&gt;&lt;br&gt;PutItem / GetItem / Query&lt;br&gt;Owner check before metadata&lt;br&gt;and before reading steps" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="360" width="430" height="230" /></mxCell><mxCell id="worker" value="Worker Lambda&lt;br&gt;&lt;br&gt;Conditional UpdateItem claim&lt;br&gt;GetItem / PutItem for runs&lt;br&gt;and ordered step events" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="820" width="430" height="230" /></mxCell><mxCell id="table-header" value="PK = RUN#&amp;lt;id&amp;gt;    |    SK     |    Record" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="280" width="1490" height="95" /></mxCell><mxCell id="key0" value="META" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="400" width="350" height="140" /></mxCell><mxCell id="value0" value="owner_id, task, max_steps, status, mode,&lt;br&gt;usage, final_answer, source_ids, timestamps" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="400" width="1120" height="140" /></mxCell><mxCell id="key1" value="STEP#0001" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="565" width="350" height="140" /></mxCell><mxCell id="value1" value="step_number=1, action_summary, tool_name,&lt;br&gt;validated tool_input, observation, source_ids" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="565" width="1120" height="140" /></mxCell><mxCell id="key2" value="STEP#0002" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="730" width="350" height="140" /></mxCell><mxCell id="value2" value="step_number=2, tool result or sanitized error&lt;br&gt;Events sorted by SK; at most eight steps" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="730" width="1120" height="140" /></mxCell><mxCell id="key3" value="ttl" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="895" width="350" height="140" /></mxCell><mxCell id="value3" value="Unix timestamp on each record&lt;br&gt;Seven-day expiration; asynchronous deletion" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="895" width="1120" height="140" /></mxCell><mxCell id="read" edge="1" parent="1" source="api" target="key0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;" value="Check owner"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="claim" edge="1" parent="1" source="worker" target="key1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="Write steps"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="635" y="935" /><mxPoint x="635" y="635" /></Array></mxGeometry></mxCell><mxCell id="bounds" value="Strongly consistent reads · Conditional create and STEP writes · RETAIN table on stack destruction · TTL does not remove a retained table" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#E9F4F4;strokeColor=#8ABDBA;fontColor=#164B4B;spacing=22;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="1110" width="1490" height="150" /></mxCell></root></mxGraphModel></diagram><diagram id="failures-and-delivery" name="Failures and delivery"><mxGraphModel dx="2800" dy="1600" grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1400"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="background" value="" style="html=1;whiteSpace=wrap;fillColor=#F4F7FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2400" height="1400" /></mxCell><mxCell id="title" value="&lt;b&gt;Application outcomes and queue retries are different mechanisms&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="40" width="2250" height="80" /></mxCell><mxCell id="subtitle" value="Handled agent failures terminate the run. Infrastructure exceptions report an SQS batch item failure." style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="140" width="2220" height="70" /></mxCell><mxCell id="footer" value="ReAct Workbench · Source-derived functional view · Manisha · 2026-10-15 · us-east-2" style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1320" width="2220" height="45" /></mxCell><mxCell id="queued" value="QUEUED" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="300" width="630" height="150" /></mxCell><mxCell id="running" value="RUNNING" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="300" width="630" height="150" /></mxCell><mxCell id="terminal" value="SUCCEEDED / LIMIT_REACHED / FAILED" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1600" y="300" width="630" height="150" /></mxCell><mxCell id="claim" edge="1" parent="1" source="queued" target="running" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;" value="Atomic claim"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="end" edge="1" parent="1" source="running" target="terminal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;" value="Persist terminal result"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="dedupe" value="&lt;b&gt;Duplicate delivery&lt;/b&gt;&lt;br&gt;Already RUNNING or terminal → claim returns None.&lt;br&gt;Skip agent execution and acknowledge the record." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#E9F4F4;strokeColor=#8ABDBA;fontColor=#164B4B;spacing=22;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="600" width="1000" height="185" /></mxCell><mxCell id="crash" value="&lt;b&gt;Crash after claim — documented gap&lt;/b&gt;&lt;br&gt;Redelivery sees RUNNING and skips.&lt;br&gt;Record can remain stranded; no stale-run sweeper exists." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFF1EB;strokeColor=#DF967E;fontColor=#803B2C;spacing=22;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="1230" y="600" width="1000" height="185" /></mxCell><mxCell id="sqs" value="SQS delivery&lt;br&gt;&lt;br&gt;1,080s visibility&lt;br&gt;maxReceiveCount = 5" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="950" width="460" height="230" /></mxCell><mxCell id="exception" value="Infrastructure exception&lt;br&gt;&lt;br&gt;Worker returns messageId&lt;br&gt;in batchItemFailures" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="680" y="950" width="460" height="230" /></mxCell><mxCell id="retry" value="Retry after visibility&lt;br&gt;&lt;br&gt;Re-deliver message&lt;br&gt;Claim still controls execution" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1260" y="950" width="460" height="230" /></mxCell><mxCell id="dlq" value="SQS dead-letter queue&lt;br&gt;&lt;br&gt;14-day retention&lt;br&gt;Depth alarm; manual investigation" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1840" y="950" width="460" height="230" /></mxCell><mxCell id="delivery" edge="1" parent="1" source="sqs" target="exception" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;dashed=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="retryflow" edge="1" parent="1" source="exception" target="retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;dashed=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="redrive" edge="1" parent="1" source="retry" target="dlq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#C66545;dashed=1;" value="Exhausted"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="build-and-deployment" name="Build and deployment"><mxGraphModel dx="2800" dy="1600" grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1400"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="background" value="" style="html=1;whiteSpace=wrap;fillColor=#F4F7FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2400" height="1400" /></mxCell><mxCe