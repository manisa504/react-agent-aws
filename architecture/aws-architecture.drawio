;" vertex="1" parent="1"><mxGeometry as="geometry" x="530" y="255" width="78" height="78" /></mxCell><mxCell id="auth-label" value="Amazon Cognito&lt;br&gt;User pool + JWT" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#172033;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="343" width="278" height="65" /></mxCell><mxCell id="api" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;strokeColor=#ffffff;fillColor=#E7157B;sketch=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="530" y="510" width="78" height="78" /></mxCell><mxCell id="api-label" value="API Gateway&lt;br&gt;HTTP API + JWT" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#172033;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="598" width="278" height="65" /></mxCell><mxCell id="lambda" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;strokeColor=#ffffff;fillColor=#ED7100;sketch=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="890" y="510" width="78" height="78" /></mxCell><mxCell id="lambda-label" value="API Lambda&lt;br&gt;FastAPI + Mangum" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#172033;" vertex="1" parent="1"><mxGeometry as="geometry" x="790" y="598" width="278" height="65" /></mxCell><mxCell id="queue" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;strokeColor=#ffffff;fillColor=#E7157B;sketch=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250" y="510" width="78" height="78" /></mxCell><mxCell id="queue-label" value="Amazon SQS&lt;br&gt;Async run queue" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#172033;" vertex="1" parent="1"><mxGeometry as="geometry" x="1150" y="598" width="278" height="65" /></mxCell><mxCell id="worker" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;strokeC