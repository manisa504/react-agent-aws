<mxfile host="app.diagrams.net"><diagram id="authentication-and-isolation" name="Authentication and isolation"><mxGraphModel dx="2800" dy="1600" grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1400"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="background" value="" style="html=1;whiteSpace=wrap;fillColor=#F4F7FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2400" height="1400" /></mxCell><mxCell id="title" value="&lt;b&gt;Identity is validated before data is returned&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="40" width="2250" height="80" /></mxCell><mxCell id="subtitle" value="Cognito authenticates. API Gateway validates tokens. The application enforces run ownership." style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="140" width="2220" height="70" /></mxCell><mxCell id="footer" value="ReAct Workbench · Source-derived functional view · Manisha · 2026-10-15 · us-east-2" style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1320" width="2220" height="45" /></mxCell><mxCell id="browser" value="Browser / Amplify" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="270" width="310" height="100" /></mxCell><mxCell id="browser-life" value="" style="endArrow=none;strokeColor=#A9B8CA;dashed=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="295" y="390" /><mxPoint as="targetPoint" x="295" y="1070" /></mxGeometry></mxCell><mxCell id="cognito" value="Cognito / SRP" st