<mxfile host="app.diagrams.net"><diagram id="failures-and-delivery" name="Failures and delivery"><mxGraphModel dx="2800" dy="1600" grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1400"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="background" value="" style="html=1;whiteSpace=wrap;fillColor=#F4F7FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2400" height="1400" /></mxCell><mxCell id="title" value="&lt;b&gt;Application outcomes and queue retries are different mechanisms&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="40" width="2250" height="80" /></mxCell><mxCell id="subtitle" value="Handled agent failures terminate the run. Infrastructure exceptions report an SQS batch item failure." style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="140" width="2220" height="70" /></mxCell><mxCell id="footer" value="ReAct Workbench · Source-derived functional view · Manisha · 2026-10-15 · us-east-2" style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1320" width="2220" height="45" /></mxCell><mxCell id="queued" value="QUEUED" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="300" width="630" height="150" /></mxCell><mxCell id="running" value="RUNNING" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="300" width="630" height="150" /></mxCell><mxCell id="terminal" value="SUCCEEDED / LIMIT_REACHED / FAILED" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1600" y="300" width="630" height="150" /></mxCell><mxCell id="claim" edge="1" parent="1" source="queued" target="running" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;" value="Atomic claim"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="end" edge="1" parent="1" source="running" target="terminal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;" value="Persist terminal result"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="dedupe" value="&lt;b&gt;Duplicate delivery&lt;/b&gt;&lt;br&gt;Already RUNNING or terminal → claim returns None.&lt;br&gt;Skip agent execution and acknowledge the record." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#E9F4F4;strokeColor=#8ABDBA;fontColor=#164B4B;spacing=22;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="600" width="1000" height="185" /></mxCell><mxCell id="crash" value="&lt;b&gt;Crash after claim — documented gap&lt;/b&gt;&lt;br&gt;Redelivery sees RUNNING and skips.&lt;br&gt;Record can remain stranded; no stale-run sweeper exists." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFF1EB;strokeColor=#DF967E;fontColor=#803B2C;spacing=22;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="1230" y="600" width="1000" height="185" /></mxCell><mxCell id="sqs" value="SQS delivery&lt;br&gt;&lt;br&gt;1,080s visibility&lt;br&gt;maxReceiveCount = 5" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;spacingTop=78;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="950" width="460" height="230" /></mxCell><mxCell id="sqs-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;strokeColor=#ffffff;fillColor=#E7157B;" vertex="1" parent="sqs"><mxGeometry as="geometry" x="201" y="22" width="58" height="58" /></mxCell><mxCell id="exception" value="Infrastructure exception&lt;br&gt;&lt;br&gt;Worker returns messageId&lt;br&gt;in batchItemFailures" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;spacingTop=78;" vertex="1" parent="1"><mxGeometry as="geometry" x="680" y="950" width="460" height="230" /></mxCell><mxCell id="exception-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;strokeColor=#ffffff;fillColor=#ED7100;" vertex="1" parent="exception"><mxGeometry as="geometry" x="201" y="22" width="58" height="58" /></mxCell><mxCell id="retry" value="Retry after visibility&lt;br&gt;&lt;br&gt;Re-deliver message&lt;br&gt;Claim still controls execution" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;spacingTop=78;" vertex="1" parent="1"><mxGeometry as="geometry" x="1260" y="950" width="460" height="230" /></mxCell><mxCell id="retry-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;strokeColor=#ffffff;fillColor=#E7157B;" vertex="1" parent="retry"><mxGeometry as="geometry" x="201" y="22" width="58" height="58" /></mxCell><mxCell id="dlq" value="SQS dead-letter queue&lt;br&gt;&lt;br&gt;14-day retention&lt;br&gt;Depth alarm; manual investigation" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;spacingTop=78;" vertex="1" parent="1"><mxGeometry as="geometry" x="1840" y="950" width="460" height="230" /></mxCell><mxCell id="dlq-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;strokeColor=#ffffff;fillColor=#E7157B;" vertex="1" parent="dlq"><mxGeometry as="geometry" x="201" y="22" width="58" height="58" /></mxCell><mxCell id="delivery" edge="1" parent="1" source="sqs" target="exception" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;dashed=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="retryflow" edge="1" parent="1" source="exception" target="retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;dashed=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="redrive" edge="1" parent="1" source="retry" target="dlq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#C66545;dashed=1;" value="Exhausted"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>