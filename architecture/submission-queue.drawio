<mxfile host="app.diagrams.net"><diagram id="submission-and-queue" name="Submission and queue"><mxGraphModel dx="2800" dy="1600" grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1400"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="background" value="" style="html=1;whiteSpace=wrap;fillColor=#F4F7FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="2400" height="1400" /></mxCell><mxCell id="title" value="&lt;b&gt;Submission returns quickly; execution happens asynchronously&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#142135;strokeColor=#142135;fontColor=#FFFFFF;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="40" width="2250" height="80" /></mxCell><mxCell id="subtitle" value="POST /runs → metadata → queue → HTTP 202. Browser polling runs concurrently with the worker." style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="140" width="2220" height="70" /></mxCell><mxCell id="footer" value="ReAct Workbench · Source-derived functional view · Manisha · 2026-10-15 · us-east-2" style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#41536B;align=left;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1320" width="2220" height="45" /></mxCell><mxCell id="browser" value="Browser&lt;br&gt;&lt;br&gt;Task ≤ 2,000 characters&lt;br&gt;Steps 3–8; default 5" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="300" width="460" height="235" /></mxCell><mxCell id="api" value="FastAPI Lambda&lt;br&gt;&lt;br&gt;Validate Pydantic request&lt;br&gt;Create owned QUEUED run" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="300" width="460" height="235" /></mxCell><mxCell id="table" value="DynamoDB META&lt;br&gt;&lt;br&gt;Condition: PK not exists&lt;br&gt;Store task, owner and budget" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1240" y="300" width="460" height="235" /></mxCell><mxCell id="queue" value="SQS queue&lt;br&gt;&lt;br&gt;Message contains run_id&lt;br&gt;Visibility: 1,080 seconds" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1810" y="300" width="460" height="235" /></mxCell><mxCell id="worker" value="Worker Lambda&lt;br&gt;&lt;br&gt;Batch size 1 / timeout 180s&lt;br&gt;Controller deadline ≤150s" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1810" y="790" width="460" height="235" /></mxCell><mxCell id="claim" value="Conditional claim&lt;br&gt;&lt;br&gt;QUEUED → RUNNING&lt;br&gt;Duplicate claim exits" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="1240" y="790" width="460" height="235" /></mxCell><mxCell id="controller" value="Shared Python controller&lt;br&gt;&lt;br&gt;Bedrock + validated tools&lt;br&gt;Persist ordered step events" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="790" width="460" height="235" /></mxCell><mxCell id="poll" value="Browser polling&lt;br&gt;&lt;br&gt;GET run, then GET steps&lt;br&gt;2 seconds until terminal" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CAD3E0;fontColor=#142135;spacing=22;fontSize=25;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="790" width="460" height="235" /></mxCell><mxCell id="flow0" edge="1" parent="1" source="browser" target="api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow1" edge="1" parent="1" source="api" target="table" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow2" edge="1" parent="1" source="api" target="queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" value="Enqueue after META"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="900" y="235" /><mxPoint x="2040" y="235" /></Array></mxGeometry></mxCell><mxCell id="flow3" edge="1" parent="1" source="queue" target="worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;dashed=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow4" edge="1" parent="1" source="worker" target="claim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow5" edge="1" parent="1" source="claim" target="controller" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="polling" edge="1" parent="1" source="poll" target="api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;endArrow=block;endFill=1;fontSize=22;html=1;labelBackgroundColor=#F4F7FB;verticalAlign=bottom;strokeColor=#416A89;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" value="JWT on reads"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="330" y="740" /><mxPoint x="610" y="740" /><mxPoint x="610" y="417" /></Array></mxGeometry></mxCell><mxCell id="response" value="&lt;b&gt;HTTP 202 immediately after enqueue&lt;/b&gt;&lt;br&gt;Return run_id + QUEUED. No waiting for Bedrock inside the HTTP request." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#E9F4F4;strokeColor=#8ABDBA;fontColor=#164B4B;spacing=22;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="1130" width="1030" height="135" /></mxCell><mxCell id="failure" value="&lt;b&gt;Enqueue failure is explicit&lt;/b&gt;&lt;br&gt;Save FAILED / MODEL_ERROR with a safe message; return HTTP 503 and run_id." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFF1EB;strokeColor=#DF967E;fontColor=#803B2C;spacing=22;fontSize=23;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="1240" y="1130" width="1030" height="135" /></mxCell></root></mxGraphModel></diagram></mxfile>