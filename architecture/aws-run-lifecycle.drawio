<mxfile host="app.diagrams.net"><diagram id="run-lifecycle" name="Run lifecycle"><mxGraphModel dx="2800" dy="1600" grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1400"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="background" value="" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=23;spacing=24;fillColor=#FFFFFF;strokeColor=#D6D1E5;fontColor=#252134;rounded=0;fillColor=#F5F5F5;strokeColor=none;"><mxGeometry as="geometry" x="0" y="0" width="2400" height="1400" /></mxCell><mxCell id="title" value="&lt;b&gt;From sign-in to a cited answer&lt;/b&gt;&lt;br&gt;Manisha | 2026-10-15 | Actual cloud request and worker lifecycle · us-east-2" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=23;spacing=24;fillColor=#FFFFFF;strokeColor=#D6D1E5;fontColor=#252134;fillColor=none;strokeColor=none;align=left;fontSize=31;"><mxGeometry as="geometry" x="60" y="40" width="2200" height="120" /></mxCell><mxCell id="signin" value="&lt;b&gt;1 · Sign in&lt;/b&gt;&lt;br&gt;&lt;br&gt;Amplify Auth uses Cognito SRP.&lt;br&gt;Access token is held by the client." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=23;spacing=24;fillColor=#FFFFFF;strokeColor=#D6D1E5;fontColor=#252134;spacingTop=78;"><mxGeometry as="geometry" x="80" y="260" width="490" height="240" /></mxCell><mxCell id="signin-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;strokeColor=#ffffff;fillColor=#DD344C;" vertex="1" parent="signin"><mxGeometry as="geometry" x="216" y="22" width="58" height="58" /></mxCell><mxCell id="jwt" value="&lt;b&gt;2 · Authorize&lt;/b&gt;&lt;br&gt;&lt;br&gt;HTTP API validates JWT issuer,&lt;br&gt;audience and required scope." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=23;spacing=24;fillColor=#FFFFFF;strokeColor=#D6D1E5;fontColor=#252134;spacingTop=78;"><mxGeometry as="geometry" x="650" y="260" width="490" height="240" /></mxCell><mxCell id="jwt-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;strokeColor=#ffffff;fillColor=#E7157B;" vertex="1" parent="jwt"><mxGeometry as="geometry" x="216" y="22" width="58" height="58" /></mxCell><mxCell id="submit" value="&lt;b&gt;3 · Submit&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /runs validates ≤ 2,000 chars&lt;br&gt;and 3–8 steps. Persist QUEUED META." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=23;spacing=24;fillColor=#FFFFFF;strokeColor=#D6D1E5;fontColor=#252134;spacingTop=78;"><mxGeometry as="geometry" x="1220" y="260" width="490" height="240" /></mxCell><mxCell id="submit-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;strokeColor=#ffffff;fillColor=#ED7100;" vertex="1" parent="submit"><mxGeometry as="geometry" x="180" y="22" width="58" height="58" /></mxCell><mxCell id="submit-icon1" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;strokeColor=#ffffff;fillColor=#C925D1;" vertex="1" parent="submit"><mxGeometry as="geometry" x="252" y="22" width="58" height="58" /></mxCell><mxCell id="enqueue" value="&lt;b&gt;4 · Enqueue&lt;/b&gt;&lt;br&gt;&lt;br&gt;Send run_id to SQS.&lt;br&gt;Return 202 + run_id immediately." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=23;spacing=24;fillColor=#FFFFFF;strokeColor=#D6D1E5;fontColor=#252134;spacingTop=78;"><mxGeometry as="geometry" x="1790" y="260" width="490" height="240" /></mxCell><mxCell id="enqueue-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;strokeColor=#ffffff;fillColor=#E7157B;" vertex="1" parent="enqueue"><mxGeometry as="geometry" x="216" y="22" width="58" height="58" /></mxCell><mxCell id="claim" value="&lt;b&gt;5 · Claim&lt;/b&gt;&lt;br&gt;&lt;br&gt;Worker conditionally claims&lt;br&gt;QUEUED → RUNNING. Skip duplicates." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=23;spacing=24;fillColor=#FFFFFF;strokeColor=#D6D1E5;fontColor=#252134;spacingTop=78;"><mxGeometry as="geometry" x="1790" y="660" width="490" height="240" /></mxCell><mxCell id="claim-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;strokeColor=#ffffff;fillColor=#ED7100;" vertex="1" parent="claim"><mxGeometry as="geometry" x="180" y="22" width="58" height="58" /></mxCell><mxCell id="claim-icon1" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;strokeColor=#ffffff;fillColor=#C925D1;" vertex="1" parent="claim"><mxGeometry as="geometry" x="252" y="22" width="58" height="58" /></mxCell><mxCell id="loop" value="&lt;b&gt;6 · Decide / validate / act&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bedrock Converse → validate →&lt;br&gt;safe tool → ordered STEP. Repeat." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=23;spacing=24;fillColor=#FFFFFF;strokeColor=#D6D1E5;fontColor=#252134;spacingTop=78;"><mxGeometry as="geometry" x="1220" y="660" width="490" height="240" /></mxCell><mxCell id="loop-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;strokeColor=#ffffff;fillColor=#01A88D;" vertex="1" parent="loop"><mxGeometry as="geometry" x="216" y="22" width="58" height="58" /></mxCell><mxCell id="finish" value="&lt;b&gt;7 · Finish&lt;/b&gt;&lt;br&gt;&lt;br&gt;Validate citation IDs. Persist final&lt;br&gt;status, reason and actual usage." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=23;spacing=24;fillColor=#FFFFFF;strokeColor=#D6D1E5;fontColor=#252134;spacingTop=78;"><mxGeometry as="geometry" x="650" y="660" width="490" height="240" /></mxCell><mxCell id="finish-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;strokeColor=#ffffff;fillColor=#C925D1;" vertex="1" parent="finish"><mxGeometry as="geometry" x="216" y="22" width="58" height="58" /></mxCell><mxCell id="poll" value="&lt;b&gt;8 · Poll / display&lt;/b&gt;&lt;br&gt;&lt;br&gt;GET metadata + steps every 2s.&lt;br&gt;Owner check on each read; stop at terminal." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=23;spacing=24;fillColor=#FFFFFF;strokeColor=#D6D1E5;fontColor=#252134;spacingTop=78;"><mxGeometry as="geometry" x="80" y="660" width="490" height="240" /></mxCell><mxCell id="poll-icon0" value="" style="sketch=0;outlineConnect=0;dashed=0;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.amplify;strokeColor=#ffffff;fillColor=#DD344C;" vertex="1" parent="poll"><mxGeometry as="geometry" x="216" y="22" width="58" height="58" /></mxCell><mxCell id="flow-0" edge="1" parent="1" source="signin" target="jwt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6955A4;strokeWidth=3;endArrow=block;endFill=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow-1" edge="1" parent="1" source="jwt" target="submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6955A4;strokeWidth=3;endArrow=block;endFill=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow-2" edge="1" parent="1" source="submit" target="enqueue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6955A4;strokeWidth=3;endArrow=block;endFill=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow-3" edge="1" parent="1" source="enqueue" target="claim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6955A4;strokeWidth=3;endArrow=block;endFill=1;dashed=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow-4" edge="1" parent="1" source="claim" target="loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6955A4;strokeWidth=3;endArrow=block;endFill=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow-5" edge="1" parent="1" source="loop" target="finish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6955A4;strokeWidth=3;endArrow=block;endFill=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow-6" edge="1" parent="1" source="finish" target="poll" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6955A4;strokeWidth=3;endArrow=block;endFill=1;dashed=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="polling-note" value="After HTTP 202, the browser polls concurrently with worker steps 5–7; it does not wait for completion to begin polling." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=23;spacing=24;fillColor=#FFFFFF;strokeColor=#D6D1E5;fontColor=#252134;fillColor=none;strokeColor=none;fontSize=23;fontColor=#6955A4;"><mxGeometry as="geometry" x="300" y="535" width="1800" height="70" /></mxCell><mxCell id="states" value="&lt;b&gt;Terminal states&lt;/b&gt;&lt;br&gt;SUCCEEDED / FINAL_ANSWER&lt;br&gt;LIMIT_REACHED / STEP_LIMIT&lt;br&gt;FAILED / UNSUPPORTED, MODEL_ERROR, TOOL_ERROR, TIMEOUT, INVALID_TOOL" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=23;spacing=24;fillColor=#FFFFFF;strokeColor=#D6D1E5;fontColor=#252134;align=left;fontSize=22;"><mxGeometry as="geometry" x="80" y="1040" width="1060" height="250" /></mxCell><mxCell id="bounds" value="&lt;b&gt;Operational bounds&lt;/b&gt;&lt;br&gt;Worker: 180s; controller: ≤150s; maxTokens: 1,000 per model request.&lt;br&gt;Native tool batches execute sequentially, one step each.&lt;br&gt;Enqueue failure: 503 + saved failure. Infrastructure retries: DLQ after five receives.&lt;br&gt;A worker crash after claim can strand RUNNING; automatic recovery is deferred." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=23;spacing=24;fillColor=#FFFFFF;strokeColor=#D6D1E5;fontColor=#252134;align=left;fontSize=22;"><mxGeometry as="geometry" x="1220" y="1040" width="1060" height="250" /></mxCell></root></mxGraphModel></diagram></mxfile>