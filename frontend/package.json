  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.27.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.1.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
